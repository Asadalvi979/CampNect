# =============================================================================
# CampNect — Production Environment Variables Template
# =============================================================================
# Copy this to .env on your server or set these as environment variables
# in your deployment platform (Railway, Render, VPS, etc.)
# =============================================================================

# Django
SECRET_KEY=generate-a-new-unique-key-with-python-manage-py-shell
DEBUG=False
ALLOWED_HOSTS=campnect-production.up.railway.app,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://campnect-production.up.railway.app,https://www.yourdomain.com
SITE_URL=https://campnect-production.up.railway.app

# Database (MySQL)
DB_NAME=campnect_db
DB_USER=root
DB_PASSWORD=strong-production-password
DB_HOST=your-mysql-host
DB_PORT=3306

# Email (SMTP via Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=CampNect <your-email@gmail.com>
